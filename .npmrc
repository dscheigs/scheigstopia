# pnpm is provided by the environment (Homebrew locally, corepack in CI via the
# packageManager field) — don't let pnpm try to self-manage its version.
manage-package-manager-versions=false

# Supply-chain guard: refuse dependency versions published in the last 24h,
# so a compromised release has to survive a day before it can land here.
minimum-release-age=1440
minimum-release-age-exclude[]=@scheigs/*

# Install peerDependencies automatically (kept explicit for clarity).
auto-install-peers=true
