# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# Neon Postgres connection string (pooled), from the Neon dashboard.
DATABASE_URL=

# Random secret for signing session cookies. Generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app credentials (Settings -> Developer settings -> OAuth Apps).
# Callback URL: <site origin>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Numeric GitHub user ID allowed to sign in (not the username).
# Find yours at https://api.github.com/users/<your-username> ("id" field).
# If unset, nobody can sign in.
ALLOWED_GITHUB_ID=

# Card scanning (milestone 2). Scanning is OFF until ANTHROPIC_API_KEY is set,
# and every scan is a paid API call. Before setting it in production, use a key
# made just for Grimoire, in an Anthropic workspace with a monthly spend limit
# (see issue #43).
ANTHROPIC_API_KEY=

# Optional. Model that reads the card name. Defaults to the smallest Claude
# model (claude-haiku-5-5) when empty.
IDENTIFY_MODEL=

# Optional. App-side caps on card scans per user (issue #43). Requests past a
# cap get a 429 and make no API call. Days and months are UTC calendar periods.
# Defaults are deliberately low: 10 per minute, 100 per day, 1000 per month.
# Raise them once you know how much scanning you actually need.
IDENTIFY_LIMIT_PER_MINUTE=
IDENTIFY_LIMIT_PER_DAY=
IDENTIFY_LIMIT_PER_MONTH=
