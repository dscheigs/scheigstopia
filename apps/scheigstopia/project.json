{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "scheigstopia",
    "projectType": "application",
    "sourceRoot": "apps/scheigstopia/src",
    "tags": ["scope:scheigstopia", "type:app"],
    "implicitDependencies": ["sylva", "sylva-ui"],
    "targets": {
        "test": {
            "command": "vitest run --root apps/scheigstopia",
            "cache": true,
            "inputs": ["default", "^default"]
        },
        "typecheck": {
            "command": "tsc --noEmit -p apps/scheigstopia/tsconfig.json",
            "cache": true,
            "inputs": ["default", "^default"]
        },
        "dev-pair": {
            "command": "next dev --port 3000",
            "options": {
                "cwd": "apps/scheigstopia",
                "env": {
                    "GRIMOIRE_URL": "http://localhost:3001"
                }
            },
            "continuous": true,
            "cache": false
        }
    }
}
