{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "scheigstopia",
    "projectType": "application",
    "sourceRoot": "apps/scheigstopia/src",
    "tags": ["scope:scheigstopia", "type:app"],
    "implicitDependencies": ["sylva"],
    "targets": {
        "test": {
            "command": "vitest run --root apps/scheigstopia",
            "cache": true,
            "inputs": ["default", "^default"]
        },
        "typecheck": {
            "command": "tsc --noEmit -p apps/scheigstopia/tsconfig.json",
            "cache": true,
            "inputs": ["default", "^default"]
        }
    }
}
