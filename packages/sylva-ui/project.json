{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "sylva-ui",
    "projectType": "library",
    "sourceRoot": "packages/sylva-ui/src",
    "tags": ["scope:sylva-ui", "type:ui"],
    "implicitDependencies": ["sylva"],
    "targets": {
        "typecheck": {
            "command": "tsc --noEmit -p packages/sylva-ui/tsconfig.json",
            "cache": true,
            "inputs": ["default", "^default"]
        },
        "test": {
            "command": "vitest run --root packages/sylva-ui",
            "cache": true,
            "inputs": ["default", "^default"]
        },
        "storybook": {
            "command": "storybook dev -p 6006 -c packages/sylva-ui/.storybook",
            "cache": false,
            "dependsOn": ["^build"]
        },
        "build-storybook": {
            "command": "storybook build -c packages/sylva-ui/.storybook -o packages/sylva-ui/storybook-static",
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["default", "^default"],
            "outputs": ["{projectRoot}/storybook-static"]
        }
    }
}
