{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "sylva-ui",
    "projectType": "library",
    "sourceRoot": "packages/sylva-ui/src",
    "tags": ["scope:sylva-ui", "type:ui"],
    "implicitDependencies": ["sylva"],
    "targets": {
        "typecheck": {
            "command": "tsc --noEmit -p packages/sylva-ui/tsconfig.json",
            "cache": true,
            "inputs": ["default", "^default"]
        },
        "test": {
            "command": "vitest run --root packages/sylva-ui",
            "cache": true,
            "inputs": ["default", "^default"]
        }
    }
}
